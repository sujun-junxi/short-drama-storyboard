# 统一换行符：仓库里一律存 LF，避免 Windows 提交把别人 clone 到的文件变成 CRLF。
# 例外见下：Windows 专用脚本保留 CRLF 更符合习惯。
* text=auto eol=lf

*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf

# 二进制：不要做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.icns binary
*.exe binary
*.asar binary
*.woff binary
*.woff2 binary
*.ttf binary

# 锁文件：合并时冲突噪音大，标记为生成物
package-lock.json linguist-generated=true
